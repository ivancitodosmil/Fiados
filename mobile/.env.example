# Copia este archivo como .env y completa los valores de tu proyecto Supabase.
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública de la web (sirve el portal del cliente en /c/<token>). Sin barra final.
EXPO_PUBLIC_PORTAL_URL=https://fiados.example.com
